@model List<Product>
@{ ViewData["Title"] = "Управление товарами"; }
<div class="container page-content admin-area">
    <partial name="_AdminNav" />
    <div class="admin-title"><div><div class="kicker">CRUD · ТОВАРЫ</div><h1 class="page-title">Лекарства и товары</h1><p class="muted">@Model.Count позиций. Скрытые товары не видны покупателям, но остаются в базе.</p></div><a class="btn btn-primary" asp-action="EditProduct">+ Создать товар</a></div>
    @if(Model.Count == 0){<div class="admin-empty"><h2>Пока нет товаров</h2><p>Добавьте первый товар, указав название, категорию, производителя и цену.</p><a class="btn btn-primary" asp-action="EditProduct">Добавить товар</a></div>}
    else {<div class="table-wrap"><table><thead><tr><th>Название</th><th>Категория / бренд</th><th>Цена</th><th>Остаток</th><th>Статус</th><th>Действия</th></tr></thead><tbody>
        @foreach(var item in Model){<tr><td><strong>@item.Name</strong>@if(item.RequiresPrescription){<small class="table-sub">По рецепту · онлайн-заказ недоступен</small>}</td><td>@item.Category?.Name<small class="table-sub">@item.Manufacturer?.Name</small></td><td>@item.Price.ToString("N2") TJS</td><td>@item.Stock</td><td><span class="status-pill @(item.IsActive ? "status-ok" : "status-muted")">@(item.IsActive ? "Активен" : "Скрыт")</span></td><td><div class="table-actions"><a class="btn btn-small btn-ghost" asp-action="EditProduct" asp-route-id="@item.Id">✎ Редактировать</a><form asp-action="ToggleProduct" method="post"><input type="hidden" name="id" value="@item.Id"/><button class="btn btn-small @(item.IsActive ? "btn-danger-soft" : "btn-ghost")" type="submit" onclick="return confirm('@(item.IsActive ? "Скрыть товар из каталога?" : "Вернуть товар в каталог?")')">@(item.IsActive ? "Скрыть" : "Восстановить")</button></form></div></td></tr>}
    </tbody></table></div>}
    <div class="admin-footnote">Удаление товаров заменено безопасным скрытием, чтобы не нарушать историю заказов.</div>
</div>
