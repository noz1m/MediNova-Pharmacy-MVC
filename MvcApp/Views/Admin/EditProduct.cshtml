@model Product
@{ViewData["Title"]=Model.Id==0?"Новый товар":"Редактирование товара";}
<div class="container page-content admin-area"><partial name="_AdminNav"/><div class="kicker">УПРАВЛЕНИЕ КАТАЛОГОМ</div><h1 class="page-title">@(Model.Id==0?"Новый товар":"Редактировать товар")</h1><form asp-action="EditProduct" method="post" class="admin-form"><input type="hidden" asp-for="Id"/><div asp-validation-summary="All" class="validation"></div><div class="form-grid"><label>Название<input asp-for="Name" required maxlength="160"/></label><label>Форма / упаковка<input asp-for="Form" maxlength="100"/></label><label>Цена, TJS<input asp-for="Price" type="number" min="0" step="0.01"/></label><label>Остаток<input asp-for="Stock" type="number" min="0"/></label><label>Категория<select asp-for="CategoryId"><option value="0">Выберите категорию</option>@foreach(Category c in ViewBag.Categories){<option value="@c.Id">@c.Name</option>}</select></label><label>Производитель<select asp-for="ManufacturerId"><option value="0">Выберите производителя</option>@foreach(Manufacturer m in ViewBag.Manufacturers){<option value="@m.Id">@m.Name</option>}</select></label><label class="wide">Ссылка на изображение<input asp-for="ImageUrl" type="url" placeholder="https://..."/></label><label class="wide">Описание<textarea asp-for="Description" rows="4"></textarea></label></div><div class="checks"><label><input asp-for="IsActive"/> Показывать в каталоге</label><label><input asp-for="RequiresPrescription"/> Требуется рецепт (запретить обычное оформление)</label></div><button class="btn btn-primary">Сохранить товар →</button><a asp-action="Products" class="btn btn-ghost">Отмена</a></form></div>