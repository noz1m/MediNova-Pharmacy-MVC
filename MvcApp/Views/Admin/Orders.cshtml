@model List<Order>
@{ ViewData["Title"] = "Заказы"; }
<div class="container page-content admin-area"><partial name="_AdminNav"/><div class="kicker">УПРАВЛЕНИЕ ЗАЯВКАМИ</div><h1 class="page-title">Заказы клиентов</h1><p class="muted">Просмотр последних 200 заказов и обновление статуса.</p>
@if(Model.Count == 0){<div class="admin-empty"><h2>Новых заявок пока нет</h2><p>Они появятся здесь после оформления корзины клиентом.</p></div>}
else{<div class="table-wrap"><table><thead><tr><th>Заказ</th><th>Клиент</th><th>Состав</th><th>Сумма</th><th>Статус и действия</th></tr></thead><tbody>@foreach(var order in Model){<tr><td><strong>#@order.Id</strong><small class="table-sub">@order.CreatedAtUtc.ToString("dd.MM.yyyy HH:mm") UTC</small></td><td>@order.CustomerName<small class="table-sub">@order.Phone</small></td><td>@foreach(var item in order.Items){<div>@item.ProductName × @item.Quantity</div>}</td><td>@order.Total.ToString("N2") TJS</td><td><strong>@order.Status</strong>@if(order.Status != OrderStatus.Cancelled && order.Status != OrderStatus.Completed){<form asp-action="Status" method="post" class="status-form"><input type="hidden" name="id" value="@order.Id"/><select name="status">@foreach(var status in Enum.GetValues<OrderStatus>()){<option value="@status" selected="@(status == order.Status)">@status</option>}</select><button class="btn btn-small btn-ghost" type="submit">Обновить</button></form>}else{<small class="table-sub">Статус окончательный</small>}</td></tr>}</tbody></table></div>}
</div>
