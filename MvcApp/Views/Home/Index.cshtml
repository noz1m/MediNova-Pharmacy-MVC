@model CatalogVm
@{ ViewData["Title"]="Каталог товаров для здоровья"; }
<section class="hero"><div class="container hero-grid"><div><div class="eyebrow"><span class="pulse"></span> ВАШЕ ЗДОРОВЬЕ — НАШ ПРИОРИТЕТ</div><h1>Забота о себе<br/><em>начинается здесь.</em></h1><p>Товары для здоровья, повседневного ухода и домашней аптечки — в одном удобном пространстве.</p><a class="btn btn-white" href="#catalog">Смотреть каталог <span>↗</span></a><div class="hero-stats"><span><b>01</b> Простая навигация</span><span><b>02</b> Прозрачные цены</span><span><b>03</b> Удобные заявки</span></div></div><div class="hero-art"><div class="floating-pill pill1">✳ Забота каждый день</div><div class="hero-cross">✚</div><div class="floating-pill pill2">Для вас и ваших близких</div></div></div></section>
<section class="trust container" id="about"><div><span class="trust-icon">✦</span><b>Удобный выбор</b><small>Фильтры и быстрый поиск</small></div><div><span class="trust-icon">✚</span><b>Проверка заказов</b><small>Подтверждение сотрудником</small></div><div><span class="trust-icon">◉</span><b>Всё под контролем</b><small>Актуальный каталог и остатки</small></div></section>
<section class="container catalog-section" id="catalog"><div class="section-header"><div><div class="kicker">КАТАЛОГ MEDINOVA</div><h2>Выбирайте с заботой</h2><p>Найдите подходящие товары по названию или категории.</p></div><span class="inventory-label">Товары для ежедневного ухода</span></div>
<form method="get" asp-controller="Home" asp-action="Index" class="filterbar"><input name="q" value="@Model.Query" placeholder="Поиск по названию товара..." aria-label="Поиск товаров"/><select name="categoryId" aria-label="Категория"><option value="">Все категории</option>@foreach(var cat in Model.Categories){if(Model.CategoryId==cat.Id){<option value="@cat.Id" selected>@cat.Name</option>}else{<option value="@cat.Id">@cat.Name</option>}}</select><button type="submit" class="btn btn-primary">Найти →</button><a class="reset" asp-controller="Home" asp-action="Index">Сбросить</a></form>
<div class="products">@foreach(var item in Model.Products){<article class="product-card"><a asp-controller="Home" asp-action="Product" asp-route-id="@item.Id" class="product-image">@if(!string.IsNullOrWhiteSpace(item.ImageUrl)){<img loading="lazy" src="@item.ImageUrl" alt="@item.Name"/>}else{<span class="product-placeholder">✚</span>}@if(item.RequiresPrescription){<span class="rx-tag">По рецепту</span>}</a><div class="product-body"><div class="category-label">@item.Category?.Name</div><h3><a asp-controller="Home" asp-action="Product" asp-route-id="@item.Id">@item.Name</a></h3><p>@(item.Form ?? item.Manufacturer?.Name ?? "Товар для здоровья")</p><div class="product-bottom"><div><b>@item.Price.ToString("N2")</b><small>сомони</small></div><a asp-controller="Home" asp-action="Product" asp-route-id="@item.Id" class="round-arrow" aria-label="Подробнее">↗</a></div></div></article>}</div>
@if(Model.Products.Count==0){<div class="empty"><span>⌕</span><h3>Ничего не найдено</h3><p>Попробуйте изменить условия поиска или добавьте товары в панели управления.</p></div>}
@if(Model.TotalPages>1){<div class="pagination">@for(var i=1;i<=Model.TotalPages;i++){<a class="@(i==Model.Page?"active":"")" asp-controller="Home" asp-action="Index" asp-route-page="@i" asp-route-q="@Model.Query" asp-route-categoryId="@Model.CategoryId">@i</a>}</div>}
</section>
<section class="container bottom-banner"><div><div class="kicker">MEDINOVA CARE</div><h2>Удобный выбор.<br/>Внимательное отношение.</h2><p>Наша задача — сделать поиск товаров для здоровья понятным и комфортным.</p></div><span>✳</span></section>