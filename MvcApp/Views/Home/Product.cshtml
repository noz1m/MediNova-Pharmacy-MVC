@model Product
@{ViewData["Title"]=Model.Name;}
<div class="container page-content"><a class="back" asp-controller="Home" asp-action="Index">← Вернуться к каталогу</a><div class="detail-grid"><div class="detail-image">@if(!string.IsNullOrWhiteSpace(Model.ImageUrl)){<img src="@Model.ImageUrl" alt="@Model.Name"/>}else{<span>✚</span>}</div><div class="detail-copy"><div class="kicker">@Model.Category?.Name</div><h1>@Model.Name</h1><p class="muted">Производитель: @(Model.Manufacturer?.Name ?? "Не указан")</p><div class="price-large">@Model.Price.ToString("N2") <small>TJS</small></div><p>@Model.Description</p>@if(!string.IsNullOrWhiteSpace(Model.Form)){<p class="muted">Форма / упаковка: @Model.Form</p>}<p class="stock">@(Model.Stock>0?$"● В наличии: {Model.Stock} шт.":"○ Нет в наличии")</p>
@if(Model.RequiresPrescription){<div class="notice">Для данного товара требуется рецепт. Онлайн-оформление недоступно: обратитесь к фармацевту для проверки рецепта и условий отпуска.</div>}else if(Model.Stock>0){<form asp-controller="Cart" asp-action="Add" method="post" class="purchase-form"><input type="hidden" name="id" value="@Model.Id"/><label>Количество <input name="quantity" type="number" min="1" max="@Math.Min(Model.Stock,99)" value="1"/></label><button class="btn btn-primary">Добавить в корзину →</button></form>}<p class="fineprint">Информация о товарах носит справочный характер и не является медицинской рекомендацией.</p></div></div></div>