@model CheckoutVm
@{ViewData["Title"]="Корзина";}
<div class="container page-content"><div class="kicker">ОФОРМЛЕНИЕ ЗАЯВКИ</div><h1 class="page-title">Ваша корзина</h1><p class="muted">Перед отправкой проверьте товары и контактные данные.</p>@if(Model.Lines.Count==0){<div class="empty"><span>♧</span><h3>В корзине пока пусто</h3><a class="btn btn-primary" asp-controller="Home" asp-action="Index">Перейти в каталог</a></div>}else{<div class="checkout-grid"><div class="cart-items">@foreach(var line in Model.Lines){<div class="cart-item"><div class="cart-thumb">✚</div><div><h3>@line.Name</h3><small>@line.Quantity шт. × @line.Price.ToString("N2") TJS</small></div><b>@line.Subtotal.ToString("N2")</b><form asp-action="Remove" method="post"><input type="hidden" name="id" value="@line.ProductId"/><button class="icon-btn" aria-label="Удалить">×</button></form></div>}<div class="cart-total"><span>Итого</span><strong>@Model.Total.ToString("N2") TJS</strong></div></div><form asp-action="Checkout" method="post" class="checkout-form"><h2>Контактные данные</h2><div asp-validation-summary="ModelOnly" class="validation"></div><label>Имя и фамилия<input asp-for="Input.CustomerName" placeholder="Как к вам обращаться"/><span asp-validation-for="Input.CustomerName"></span></label><label>Телефон<input asp-for="Input.Phone" placeholder="+992 ..."/><span asp-validation-for="Input.Phone"></span></label><label>Email (необязательно)<input asp-for="Input.Email" placeholder="you@example.com"/><span asp-validation-for="Input.Email"></span></label><label>Комментарий<textarea asp-for="Input.Comment" rows="3" placeholder="Удобное время для связи"></textarea></label><button class="btn btn-primary btn-full">Отправить заявку →</button><p class="fineprint">Это заявка на подтверждение наличия, не онлайн-оплата. Рецептурные товары нельзя оформить через корзину.</p></form></div>}</div>